# NEVER commit these — keystore = signing key, losing it = never being able
# to update the app on Play Store ever again. Back it up outside the repo
# (1Password / Google Drive / iCloud) and store the password separately.
android.keystore
*.keystore
*.jks
keystore.properties
signing-key.properties

